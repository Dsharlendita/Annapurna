APP_NAME="Annapurna Adventure"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=annapurna
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Email (kode verifikasi masuk / lupa kata sandi, akun staff).
# MAIL_MAILER=log  → email TIDAK dikirim, isinya ditulis ke storage/logs/laravel.log (cukup untuk coba di laptop).
# Kirim sungguhan lewat Gmail khusus sistem (akun pengirim saja, bukan Gmail Owner): ganti ke smtp, isi Sandi Aplikasi
# 16 huruf TANPA spasi dari myaccount.google.com/apppasswords (bukan kata sandi Gmail biasa; Verifikasi 2 Langkah harus aktif).
# MAIL_FROM_ADDRESS harus sama dengan MAIL_USERNAME. Balasan diarahkan ke email Owner lewat MAIL_REPLY_TO_ADDRESS.
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=akun.sistem@gmail.com
#   MAIL_PASSWORD=abcdefghijklmnop
#   MAIL_FROM_ADDRESS="akun.sistem@gmail.com"
#   MAIL_REPLY_TO_ADDRESS=email.owner@gmail.com
# Cek: php artisan mail:tes alamat@gmail.com --jenis=staff
# Email akun Owner + penerima rekap: php artisan owner:email email.owner@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="annapurnaadv@gmail.com"
MAIL_FROM_NAME="Annapurna Adventure"

# Masuk / daftar dengan Google (gratis). Buat di console.cloud.google.com:
#   APIs & Services → OAuth consent screen (External) → Credentials → Create credentials → OAuth client ID (Web application)
#   Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback  (saat online: https://domain-toko/auth/google/callback)
# Kosongkan = tombol "Masuk dengan Google" tidak ditampilkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Asisten Trip (tanya jawab & rencana trip) - kunci dari https://aistudio.google.com/apikey
# Kosong = asisten memakai jawaban berbasis aturan (tetap jalan).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=1000
